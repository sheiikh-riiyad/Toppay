{
  "expo": {
    "name": "Toppay",
    "slug": "toppay-official",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toppay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.toppay.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "Toppay uses your contacts to help you choose recipients for money transfers."
      }
    },
    "android": {
      "package": "com.toppay.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 5,
      "permissions": [
        "READ_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5339104f-4fd7-48a5-82a4-79e76c0f56a2"
      }
    },
    "owner": "toppay-mobile"
  }
}
