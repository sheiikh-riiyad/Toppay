{
  "expo": {
    "name": "Toppay",
    "slug": "toppay-official",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "scheme": "toppay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.toppay.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "Toppay uses your contacts to help you choose recipients for money transfers."
      }
    },
    "android": {
      "package": "com.toppay.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 6,
      "permissions": [
        "READ_CONTACTS",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#081111",
        "foregroundImage": "./logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./first-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#081111",
          "dark": {
            "backgroundColor": "#081111"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5339104f-4fd7-48a5-82a4-79e76c0f56a2"
      }
    },
    "owner": "toppay-mobile"
  }
}
